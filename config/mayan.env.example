# Copier vers config/mayan.env — variables Mayan EDMS 4.12
# Doc : https://docs.mayan-edms.com/chapters/settings.html

# Langues OCR Tesseract (français prioritaire)
MAYAN_OCR_PARSER_TESSERACT_LANGUAGE=fra+eng
MAYAN_OCR_AUTO_OCR=true

# Recherche plein-texte (backend Django par défaut, simple et suffisant en MVP)
MAYAN_SEARCH_BACKEND=django

# Upload / sources
MAYAN_SOURCES_STAGING_FILE_EXPIRATION_INTERVAL=86400
MAYAN_DOCUMENTS_UPLOAD_MAX_MEMORY_SIZE=52428800

# Throttling API (défaut 4.12 : 20 req/s user authentifié)
MAYAN_REST_API_THROTTLING_ENABLED=true

# Timezone Madagascar
MAYAN_COMMON_TIME_ZONE=Indian/Antananarivo
MAYAN_COMMON_LANGUAGE=fr

# SSO OIDC — à renseigner si profil sso activé (Keycloak)
# MAYAN_AUTHENTICATION_OIDC_ENABLED=true
# MAYAN_AUTHENTICATION_OIDC_PROVIDER_URL=http://keycloak:8080/realms/meh
# MAYAN_AUTHENTICATION_OIDC_CLIENT_ID=mayan
# MAYAN_AUTHENTICATION_OIDC_CLIENT_SECRET=change-me
