# Copier vers config/mayan.env — réglages Mayan EDMS 4.12
# Chaque réglage Mayan se passe en variable MAYAN_<NOM_GLOBAL>.
# Doc : https://docs.mayan-edms.com/chapters/settings.html

# Langue par défaut des documents = langue OCR Tesseract (code ISO 639-3)
MAYAN_DOCUMENTS_LANGUAGE=fra
MAYAN_OCR_AUTO_OCR=true

# Interface et fuseau horaire Madagascar
MAYAN_LANGUAGE_CODE=fr
MAYAN_TIME_ZONE=Indian/Antananarivo
MAYAN_COMMON_PROJECT_TITLE=GED-ECM MEH

# Recherche plein-texte : Whoosh (défaut Mayan). OpenSearch/Elasticsearch au-delà de ~500k pages.
# MAYAN_SEARCH_BACKEND=mayan.apps.dynamic_search.backends.whoosh.WhooshSearchBackend

# SMTP MEH pour les notifications (à renseigner)
# MAYAN_EMAIL_HOST=smtp.meh.mg
# MAYAN_EMAIL_PORT=587
# MAYAN_EMAIL_USE_TLS=true
# MAYAN_EMAIL_HOST_USER=ged@meh.mg
# MAYAN_EMAIL_HOST_PASSWORD=change-me

# SSO OIDC (profil sso, Keycloak realm `meh`) : se configure dans l'UI Mayan
# (Système > Paramètres > Authentication) après création du client `mayan`.
