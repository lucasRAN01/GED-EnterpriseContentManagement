{
  "name": "GED-ECM Mayan",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "portsAttributes": {
    "8000": { "label": "Mayan EDMS", "onAutoForward": "openPreview" },
    "3000": { "label": "Metabase (profil stats)", "onAutoForward": "silent" },
    "8080": { "label": "Keycloak (profil sso)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "cp -n .env.example .env; cp -n config/mayan.env.example config/mayan.env; docker compose version",
  "remoteUser": "vscode"
}
