{
  "name": "GED-ECM Mayan",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Mayan EDMS", "onAutoForward": "openBrowser" },
    "3000": { "label": "Metabase (profil stats)", "onAutoForward": "silent" },
    "8080": { "label": "Keycloak (profil sso)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "remoteUser": "vscode"
}
